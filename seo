<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phare — Agent IA SEO & GEO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-950:#080B14;
    --navy-900:#0E1424;
    --navy-800:#151D33;
    --navy-700:#1D2740;
    --gold:#C9A15C;
    --gold-light:#E4C892;
    --gold-dim:rgba(201,161,92,0.16);
    --text:#ECE9E0;
    --text-muted:#8891A6;
    --text-faint:#5C6478;
    --border:rgba(201,161,92,0.14);
    --green:#6FAE7D;
    --amber:#D6A24C;
    --red:#C46257;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--navy-950);
    color:var(--text);
    font-family:'Inter',sans-serif;
    min-height:100vh;
  }
  ::selection{background:var(--gold-dim);color:var(--gold-light);}
  .app{
    display:grid;
    grid-template-columns:260px 1fr 320px;
    min-height:100vh;
  }
  @media (max-width:980px){
    .app{grid-template-columns:1fr;}
    .sidebar{display:none;}
    .serp-panel{border-left:none;border-top:1px solid var(--border);}
  }

  /* ---- Sidebar ---- */
  .sidebar{
    background:var(--navy-900);
    border-right:1px solid var(--border);
    padding:28px 20px;
    display:flex;
    flex-direction:column;
    gap:28px;
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .brand svg{flex-shrink:0;}
  .brand-name{font-family:'Fraunces',serif;font-size:22px;font-weight:600;color:var(--gold-light);letter-spacing:0.3px;}
  .brand-tag{font-size:11px;color:var(--text-faint);margin-top:2px;letter-spacing:0.4px;text-transform:uppercase;}

  .sidebar-section-title{
    font-size:11px;text-transform:uppercase;letter-spacing:0.8px;
    color:var(--text-faint);margin-bottom:10px;font-weight:500;
  }
  .prompt-chip{
    display:block;width:100%;text-align:left;
    background:var(--navy-800);border:1px solid var(--border);
    color:var(--text);font-family:'Inter',sans-serif;font-size:13px;
    padding:10px 12px;border-radius:8px;margin-bottom:8px;cursor:pointer;
    transition:border-color .15s, background .15s;
    line-height:1.4;
  }
  .prompt-chip:hover{border-color:var(--gold);background:var(--navy-700);}
  .prompt-chip .icon{color:var(--gold);margin-right:6px;font-size:12px;}

  .sidebar-footer{
    margin-top:auto;font-size:11px;color:var(--text-faint);
    border-top:1px solid var(--border);padding-top:16px;line-height:1.6;
  }
  .sidebar-footer strong{color:var(--text-muted);}

  /* ---- Main chat ---- */
  .main{display:flex;flex-direction:column;height:100vh;}
  .main-header{
    padding:18px 28px;border-bottom:1px solid var(--border);
    display:flex;align-items:center;justify-content:space-between;
  }
  .main-header h1{font-family:'Fraunces',serif;font-size:16px;font-weight:500;margin:0;color:var(--text);}
  .status-dot{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--text-faint);}
  .status-dot::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block;}

  .chat-scroll{
    flex:1;overflow-y:auto;padding:24px 28px;
    display:flex;flex-direction:column;gap:18px;
  }
  .empty-state{
    margin:auto;text-align:center;max-width:420px;color:var(--text-muted);
  }
  .empty-state h2{font-family:'Fraunces',serif;font-weight:500;color:var(--gold-light);font-size:19px;margin-bottom:8px;}
  .empty-state p{font-size:13.5px;line-height:1.6;}

  .msg{max-width:82%;}
  .msg.user{align-self:flex-end;}
  .msg.agent{align-self:flex-start;}
  .msg-bubble{
    padding:13px 16px;border-radius:12px;font-size:14px;line-height:1.65;white-space:pre-wrap;
  }
  .msg.user .msg-bubble{background:var(--gold-dim);border:1px solid var(--border);color:var(--text);border-bottom-right-radius:3px;}
  .msg.agent .msg-bubble{background:var(--navy-800);border:1px solid var(--border);color:var(--text);border-bottom-left-radius:3px;}
  .msg-label{font-size:10px;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-faint);margin-bottom:5px;padding:0 2px;}
  .msg.user .msg-label{text-align:right;}

  .msg-bubble .tag{
    display:inline-block;background:var(--navy-700);border:1px solid var(--border);
    color:var(--gold-light);font-family:'JetBrains Mono',monospace;font-size:12px;
    padding:1px 7px;border-radius:5px;margin:0 1px;
  }
  .msg-bubble strong{color:var(--gold-light);font-weight:600;}

  .typing{display:flex;gap:4px;padding:4px 2px;}
  .typing span{width:5px;height:5px;border-radius:50%;background:var(--gold);opacity:0.4;animation:blink 1.1s infinite;}
  .typing span:nth-child(2){animation-delay:0.18s;}
  .typing span:nth-child(3){animation-delay:0.36s;}
  @keyframes blink{0%,80%,100%{opacity:0.25;}40%{opacity:0.9;}}

  .input-bar{
    padding:16px 28px 22px;border-top:1px solid var(--border);
    display:flex;gap:10px;align-items:flex-end;
  }
  .input-bar textarea{
    flex:1;resize:none;background:var(--navy-800);border:1px solid var(--border);
    color:var(--text);font-family:'Inter',sans-serif;font-size:14px;
    padding:12px 14px;border-radius:10px;min-height:46px;max-height:140px;
    line-height:1.5;outline:none;
  }
  .input-bar textarea:focus{border-color:var(--gold);}
  .input-bar textarea::placeholder{color:var(--text-faint);}
  .send-btn{
    background:var(--gold);border:none;color:var(--navy-950);font-weight:600;
    font-size:13px;padding:0 20px;height:46px;border-radius:10px;cursor:pointer;
    font-family:'Inter',sans-serif;transition:background .15s;
  }
  .send-btn:hover{background:var(--gold-light);}
  .send-btn:disabled{background:var(--navy-700);color:var(--text-faint);cursor:not-allowed;}

  /* ---- SERP preview panel ---- */
  .serp-panel{
    background:var(--navy-900);border-left:1px solid var(--border);
    padding:24px 20px;overflow-y:auto;
  }
  .serp-panel-title{
    font-family:'Fraunces',serif;font-size:14px;color:var(--gold-light);
    margin-bottom:4px;font-weight:500;
  }
  .serp-panel-sub{font-size:11.5px;color:var(--text-faint);margin-bottom:18px;line-height:1.5;}

  .serp-card{
    background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;
  }
  .serp-url{font-family:arial,sans-serif;font-size:12px;color:#4d5156;display:flex;align-items:center;gap:6px;}
  .serp-url .favicon{width:16px;height:16px;border-radius:50%;background:var(--gold);flex-shrink:0;}
  .serp-title{font-family:arial,sans-serif;font-size:18px;color:#1a0dab;margin:4px 0 3px;line-height:1.3;cursor:pointer;}
  .serp-title:hover{text-decoration:underline;}
  .serp-desc{font-family:arial,sans-serif;font-size:13px;color:#4d5156;line-height:1.55;}
  .serp-placeholder{color:#9aa0a6;font-style:italic;}

  .char-meter{margin-top:6px;}
  .char-meter-label{
    display:flex;justify-content:space-between;font-size:10.5px;
    color:var(--text-faint);margin-bottom:4px;font-family:'JetBrains Mono',monospace;
  }
  .char-meter-bar{height:4px;background:var(--navy-700);border-radius:2px;overflow:hidden;}
  .char-meter-fill{height:100%;border-radius:2px;transition:width .2s, background .2s;}

  .serp-field-block{margin-bottom:18px;}

  .serp-empty{
    text-align:center;padding:40px 10px;color:var(--text-faint);font-size:12.5px;line-height:1.6;
  }
  .serp-empty .icon{font-size:22px;color:var(--gold);margin-bottom:8px;display:block;}

  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-thumb{background:var(--navy-700);border-radius:4px;}
  ::-webkit-scrollbar-track{background:transparent;}
</style>
</head>
<body>

<div class="app">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="brand">
      <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
        <circle cx="17" cy="17" r="16" stroke="#C9A15C" stroke-width="1.2" opacity="0.35"/>
        <path d="M17 6L20 15L29 17L20 19L17 28L14 19L5 17L14 15L17 6Z" fill="#C9A15C"/>
      </svg>
      <div>
        <div class="brand-name">Phare</div>
        <div class="brand-tag">SEO &amp; GEO Copilot</div>
      </div>
    </div>

    <div>
      <div class="sidebar-section-title">Démarrage rapide</div>
      <button class="prompt-chip" data-prompt="Fais un audit SEO rapide de ce site : [colle l'URL ou décris la page]. Analyse la structure des titres, la vitesse perçue, le maillage interne et les points bloquants.">
        <span class="icon">◆</span>Audit rapide de page
      </button>
      <button class="prompt-chip" data-prompt="Trouve-moi des mots-clés et longue traîne pertinents pour le sujet suivant : [décris ton activité ou ta page]. Indique le volume de recherche estimé et l'intention de recherche pour chacun.">
        <span class="icon">◆</span>Recherche de mots-clés
      </button>
      <button class="prompt-chip" data-prompt="Rédige un meta title et une meta description optimisés pour cette page : [décris la page et le mot-clé cible].">
        <span class="icon">◆</span>Optimiser title &amp; meta description
      </button>
      <button class="prompt-chip" data-prompt="Propose-moi une structure de contenu (H1, H2, H3) pour un article sur : [sujet]. Le mot-clé cible est [mot-clé].">
        <span class="icon">◆</span>Structurer un contenu
      </button>
      <button class="prompt-chip" data-prompt="Comment optimiser cette page pour les moteurs génératifs (ChatGPT, Perplexity, AI Overviews) en plus du SEO classique ? Contexte : [décris ta page ou ton activité].">
        <span class="icon">◆</span>Optimisation GEO (IA génératives)
      </button>
      <button class="prompt-chip" data-prompt="Donne-moi 8 idées de contenus tendance et des sujets connexes pour ce secteur : [décris ton secteur d'activité].">
        <span class="icon">◆</span>Idées de contenu &amp; tendances
      </button>
    </div>

    <div class="sidebar-footer">
      <strong>Phare</strong> t'aide à rendre ton contenu visible — pour Google comme pour les IA génératives. Il ne remplace pas un audit complet avec données réelles (Search Console, GA4).
    </div>
  </div>

  <!-- MAIN CHAT -->
  <div class="main">
    <div class="main-header">
      <h1>Session SEO</h1>
      <span class="status-dot">Prêt</span>
    </div>

    <div class="chat-scroll" id="chatScroll">
      <div class="empty-state" id="emptyState">
        <h2>À quoi travaillons-nous ?</h2>
        <p>Décris ta page, ton site ou ton sujet — Phare propose mots-clés, structure, meta tags et recommandations GEO. L'aperçu Google se met à jour à droite dès qu'un title ou une description est suggéré.</p>
      </div>
    </div>

    <div class="input-bar">
      <textarea id="userInput" placeholder="Décris ta page, ton mot-clé cible, ou colle un brief..." rows="1"></textarea>
      <button class="send-btn" id="sendBtn">Envoyer</button>
    </div>
  </div>

  <!-- SERP PREVIEW -->
  <div class="serp-panel">
    <div class="serp-panel-title">Aperçu Google</div>
    <div class="serp-panel-sub">Se met à jour automatiquement quand Phare propose un title ou une meta description.</div>

    <div id="serpContent">
      <div class="serp-empty">
        <span class="icon">◆</span>
        Aucune balise proposée pour l'instant.<br>Demande une optimisation de title ou de meta description.
      </div>
    </div>
  </div>

</div>

<script>
const chatScroll = document.getElementById('chatScroll');
const emptyState = document.getElementById('emptyState');
const userInput = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');
const serpContent = document.getElementById('serpContent');

let history = [];
let lastSerp = { url: null, title: null, desc: null };

const SYSTEM_PROMPT = `Tu es Phare, un consultant expert en SEO et en GEO (Generative Engine Optimization) qui répond en français, avec un ton direct, concret et professionnel — jamais générique.

Ton rôle : aider à améliorer la visibilité d'un contenu sur Google ET sur les moteurs génératifs (ChatGPT, Perplexity, AI Overviews, Copilot).

Règles de réponse :
- Sois concret et actionnable. Pas de généralités du type "le SEO c'est important". Donne des recommandations précises et applicables.
- Quand tu suggères des mots-clés, indique à chaque fois l'intention de recherche (informationnelle, transactionnelle, navigationnelle) et une estimation qualitative du niveau de concurrence (faible/moyen/élevé).
- Quand tu proposes une structure de contenu, utilise une hiérarchie H1/H2/H3 claire.
- Pour la partie GEO, explique concrètement comment structurer le contenu pour être cité par les IA génératives (réponses directes en haut de page, formulations en questions-réponses, données factuelles vérifiables, structuration claire).
- Reste synthétique : réponses de 150 à 300 mots sauf si l'utilisateur demande plus de détail.
- N'utilise JAMAIS de tableaux markdown complexes ; préfère des listes à puces courtes.

IMPORTANT — format spécial pour les balises SEO :
Chaque fois que tu proposes ou modifies un meta title, une meta description, ou une URL suggérée pour une page, tu DOIS les inclure entre ces balises exactes, en plus de les mentionner naturellement dans ta réponse :
[SERP_URL]exemple.com/page[/SERP_URL]
[SERP_TITLE]Le title proposé ici[/SERP_TITLE]
[SERP_DESC]La meta description proposée ici[/SERP_DESC]

N'inclus ces balises QUE quand tu proposes réellement un title/description/URL, pas sinon. Utilise toujours les trois quand tu en donnes un, en réutilisant l'URL précédente si elle n'a pas changé.`;

function autoResize(){
  userInput.style.height = 'auto';
  userInput.style.height = Math.min(userInput.scrollHeight, 140) + 'px';
}
userInput.addEventListener('input', autoResize);
userInput.addEventListener('keydown', (e) => {
  if(e.key === 'Enter' && !e.shiftKey){
    e.preventDefault();
    send();
  }
});

document.querySelectorAll('.prompt-chip').forEach(btn => {
  btn.addEventListener('click', () => {
    userInput.value = btn.dataset.prompt;
    autoResize();
    userInput.focus();
  });
});

function addMessage(role, text){
  if(emptyState) emptyState.remove();
  const wrap = document.createElement('div');
  wrap.className = 'msg ' + role;
  const label = document.createElement('div');
  label.className = 'msg-label';
  label.textContent = role === 'user' ? 'Toi' : 'Phare';
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.innerHTML = formatText(text);
  wrap.appendChild(label);
  wrap.appendChild(bubble);
  chatScroll.appendChild(wrap);
  chatScroll.scrollTop = chatScroll.scrollHeight;
  return bubble;
}

function formatText(text){
  let clean = text
    .replace(/\[SERP_URL\][\s\S]*?\[\/SERP_URL\]/g, '')
    .replace(/\[SERP_TITLE\][\s\S]*?\[\/SERP_TITLE\]/g, '')
    .replace(/\[SERP_DESC\][\s\S]*?\[\/SERP_DESC\]/g, '')
    .trim();
  clean = clean.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  clean = clean.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  clean = clean.replace(/`([^`]+)`/g, '<span class="tag">$1</span>');
  return clean;
}

function addTyping(){
  if(emptyState) emptyState.remove();
  const wrap = document.createElement('div');
  wrap.className = 'msg agent';
  wrap.id = 'typingIndicator';
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
  wrap.appendChild(bubble);
  chatScroll.appendChild(wrap);
  chatScroll.scrollTop = chatScroll.scrollHeight;
}
function removeTyping(){
  const el = document.getElementById('typingIndicator');
  if(el) el.remove();
}

function extractSerp(text){
  const urlMatch = text.match(/\[SERP_URL\]([\s\S]*?)\[\/SERP_URL\]/);
  const titleMatch = text.match(/\[SERP_TITLE\]([\s\S]*?)\[\/SERP_TITLE\]/);
  const descMatch = text.match(/\[SERP_DESC\]([\s\S]*?)\[\/SERP_DESC\]/);
  if(urlMatch) lastSerp.url = urlMatch[1].trim();
  if(titleMatch) lastSerp.title = titleMatch[1].trim();
  if(descMatch) lastSerp.desc = descMatch[1].trim();
  if(titleMatch || descMatch || urlMatch) renderSerp();
}

function meterColor(len, min, max){
  if(len === 0) return 'var(--navy-700)';
  if(len < min || len > max) return 'var(--red)';
  if(len > max * 0.92) return 'var(--amber)';
  return 'var(--green)';
}

function renderSerp(){
  const title = lastSerp.title || '';
  const desc = lastSerp.desc || '';
  const url = lastSerp.url || 'exemple.com/page';

  const titleLen = title.length;
  const descLen = desc.length;
  const titlePct = Math.min(100, (titleLen / 60) * 100);
  const descPct = Math.min(100, (descLen / 160) * 100);

  serpContent.innerHTML = `
    <div class="serp-card">
      <div class="serp-url"><span class="favicon"></span>${escapeHtml(url)}</div>
      <div class="serp-title">${title ? escapeHtml(title) : '<span class="serp-placeholder">Title non défini</span>'}</div>
      <div class="serp-desc">${desc ? escapeHtml(desc) : '<span class="serp-placeholder">Description non définie</span>'}</div>
    </div>

    <div class="serp-field-block">
      <div class="char-meter">
        <div class="char-meter-label"><span>Title</span><span>${titleLen} / 60</span></div>
        <div class="char-meter-bar"><div class="char-meter-fill" style="width:${titlePct}%;background:${meterColor(titleLen,30,60)}"></div></div>
      </div>
    </div>

    <div class="serp-field-block">
      <div class="char-meter">
        <div class="char-meter-label"><span>Description</span><span>${descLen} / 160</span></div>
        <div class="char-meter-bar"><div class="char-meter-fill" style="width:${descPct}%;background:${meterColor(descLen,120,160)}"></div></div>
      </div>
    </div>
  `;
}

function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function send(){
  const text = userInput.value.trim();
  if(!text) return;
  userInput.value = '';
  autoResize();
  sendBtn.disabled = true;

  addMessage('user', text);
  history.push({ role: 'user', content: text });
  addTyping();

  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        system: SYSTEM_PROMPT,
        messages: history
      })
    });
    const data = await response.json();
    removeTyping();

    const textBlocks = (data.content || []).filter(b => b.type === 'text').map(b => b.text);
    const fullText = textBlocks.join('\n').trim() || "Je n'ai pas pu générer de réponse. Reformule ta demande.";

    addMessage('agent', fullText);
    extractSerp(fullText);
    history.push({ role: 'assistant', content: fullText });
  }catch(err){
    removeTyping();
    addMessage('agent', "Erreur de connexion. Vérifie ta connexion et réessaie dans un instant.");
    console.error(err);
  }finally{
    sendBtn.disabled = false;
    userInput.focus();
  }
}

sendBtn.addEventListener('click', send);
</script>

</body>
</html>
