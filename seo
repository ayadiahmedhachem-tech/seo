"""
Phare — Agent IA specialise SEO & GEO (Generative Engine Optimization)
Construit avec LangChain + Claude (Anthropic).

Usage:
    export ANTHROPIC_API_KEY="sk-ant-..."
    python seo_agent.py
"""

import os
import sys
from dotenv import load_dotenv

from langchain_anthropic import ChatAnthropic
from langchain_community.tools import DuckDuckGoSearchRun
from langchain.agents import create_agent
from langchain.tools import tool
from langchain_core.messages import HumanMessage

load_dotenv()

MODEL_NAME = "claude-sonnet-4-6"

SYSTEM_PROMPT = """Tu es Phare, un consultant expert en SEO et en GEO \
(Generative Engine Optimization) qui repond en francais, avec un ton direct, \
concret et professionnel.

Ton role : aider a ameliorer la visibilite d'un contenu sur Google ET sur les \
moteurs generatifs (ChatGPT, Perplexity, AI Overviews, Copilot).

Regles :
- Sois concret et actionnable, jamais generique.
- Pour les mots-cles : indique l'intention de recherche (informationnelle, \
transactionnelle, navigationnelle) et une estimation qualitative de la \
concurrence (faible / moyenne / elevee).
- Pour la structure de contenu : utilise une hierarchie H1/H2/H3 claire.
- Pour la partie GEO : explique comment structurer le contenu pour etre cite \
par les IA generatives (reponses directes en haut de page, formulations en \
questions-reponses, donnees verifiables, structuration claire).
- Utilise l'outil `verifier_longueur_balise` des que tu proposes un meta \
title ou une meta description, pour valider que la longueur est optimale \
avant de la donner a l'utilisateur.
- Utilise l'outil `recherche_web` quand tu as besoin d'infos recentes : \
tendances, concurrents, actualite d'un secteur.
- Reponses synthetiques (150-300 mots) sauf si on te demande plus de detail.
- Pas de tableaux markdown complexes, prefere des listes a puces courtes.
"""


@tool
def verifier_longueur_balise(texte: str, type_balise: str) -> str:
    """Verifie si un meta title ou une meta description respecte la longueur
    optimale pour le SEO.

    Args:
        texte: le contenu de la balise a verifier (title ou description)
        type_balise: "title" ou "description"
    """
    longueur = len(texte)
    if type_balise.lower() == "title":
        mini, maxi = 30, 60
    elif type_balise.lower() == "description":
        mini, maxi = 120, 160
    else:
        return "type_balise invalide, utilise 'title' ou 'description'."

    if longueur < mini:
        statut = f"trop courte ({longueur} caracteres, ideal {mini}-{maxi})"
    elif longueur > maxi:
        statut = f"trop longue ({longueur} caracteres, ideal {mini}-{maxi}), risque de troncature dans les resultats Google"
    else:
        statut = f"longueur optimale ({longueur} caracteres, dans la fourchette {mini}-{maxi})"

    return f"{type_balise}: {statut}"


def build_tools():
    search = DuckDuckGoSearchRun(name="recherche_web")
    search.description = (
        "Recherche des informations recentes sur le web : tendances, "
        "concurrents, actualite d'un secteur, volumes approximatifs "
        "d'interet pour un sujet. Utilise une requete courte et precise."
    )
    return [search, verifier_longueur_balise]


def build_agent():
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        print(
            "Erreur: la variable d'environnement ANTHROPIC_API_KEY n'est pas definie.\n"
            "Fais: export ANTHROPIC_API_KEY='sk-ant-...' puis relance le script."
        )
        sys.exit(1)

    llm = ChatAnthropic(model=MODEL_NAME, temperature=0.4, max_tokens=1200)
    tools = build_tools()

    agent = create_agent(model=llm, tools=tools, system_prompt=SYSTEM_PROMPT)
    return agent


def run_cli():
    agent = build_agent()
    messages = []

    print("=" * 60)
    print("  Phare — Agent SEO & GEO (Python / LangChain)")
    print("  Tape 'quitter' pour sortir.")
    print("=" * 60)

    while True:
        try:
            user_input = input("\nToi > ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nA bientot.")
            break

        if not user_input:
            continue
        if user_input.lower() in {"quitter", "exit", "quit"}:
            print("A bientot.")
            break

        messages.append(HumanMessage(content=user_input))
        result = agent.invoke({"messages": messages})
        reponse_msg = result["messages"][-1]
        reponse = reponse_msg.content

        print(f"\nPhare > {reponse}")

        messages = result["messages"]


if __name__ == "__main__":
    run_cli()
