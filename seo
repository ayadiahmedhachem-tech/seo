def execute_tool_call(tool_call):

    function_name = tool_call.function.name

    try:

        function_args = json.loads(
            tool_call.function.arguments
        )

    except json.JSONDecodeError as e:

        return (
            f"Erreur JSON dans les arguments de "
            f"{function_name} : {str(e)}"
        )

    if function_name not in AVAILABLE_FUNCTIONS:

        return (
            f"Outil inconnu : {function_name}"
        )

    function_to_call = (
        AVAILABLE_FUNCTIONS[function_name]
    )

    try:

        result = function_to_call(
            **function_args
        )

        return str(result)

    except Exception as e:

        return (
            f"Erreur lors de l'exécution de "
            f"{function_name} : {str(e)}"
        )


# ============================================================
# AGENT PHARE
# ============================================================

def ask_phare(messages):
    """
    Envoie une conversation à Qwen via Groq
    et gère automatiquement les tool calls.
    """

    while True:

        response = client.chat.completions.create(

            model=MODEL_NAME,

            messages=messages,

            tools=TOOLS,

            tool_choice="auto",

            temperature=0.6,

            max_completion_tokens=2048,

            top_p=0.95,

            reasoning_effort="default"
        )

        assistant_message = (
            response.choices[0].message
        )

        # ----------------------------------------------------
        # Aucun outil demandé
        # ----------------------------------------------------

        if not assistant_message.tool_calls:

            return assistant_message.content

        # ----------------------------------------------------
        # Ajouter la réponse de l'assistant
        # ----------------------------------------------------

        messages.append(
            assistant_message
        )

        # ----------------------------------------------------
        # Exécuter les outils
        # ----------------------------------------------------

        for tool_call in assistant_message.tool_calls:

            print(
                f"\n[Phare → outil : "
                f"{tool_call.function.name}]"
            )

            result = execute_tool_call(
                tool_call
            )

            # ------------------------------------------------
            # Ajouter le résultat de l'outil
            # ------------------------------------------------

            messages.append(
                {
                    "role": "tool",

                    "tool_call_id":
                        tool_call.id,

                    "name":
                        tool_call.function.name,

                    "content":
                        result
                }
            )


