# ============================================================
# OUTIL : VÉRIFICATION META TITLE / DESCRIPTION
# ============================================================

def verifier_longueur_balise(
    texte,
    type_balise
):
    """
    Vérifie la longueur d'une balise SEO.
    """

    longueur = len(texte)

    type_balise = type_balise.lower().strip()

    if type_balise == "title":

        minimum = 30
        maximum = 60

    elif type_balise == "description":

        minimum = 120
        maximum = 160

    else:

        return (
            "Erreur : type_balise invalide. "
            "Utilise 'title' ou 'description'."
        )

    if longueur < minimum:

        statut = (
            f"TROP COURTE — {longueur} caractères. "
            f"Longueur recommandée : {minimum}-{maximum}."
        )

    elif longueur > maximum:

        statut = (
            f"TROP LONGUE — {longueur} caractères. "
            f"Longueur recommandée : {minimum}-{maximum}. "
            "Risque de troncature dans Google."
        )

    else:

        statut = (
            f"OPTIMALE — {longueur} caractères. "
            f"Fourchette : {minimum}-{maximum}."
        )

    return (
        f"{type_balise.upper()} : {statut}\n"
        f"Texte : {texte}"
    )


